{
    "name": "tamagoage/pet-diary",
    "autoload": {
        "psr-4": {
            "Tamagoage\\PetDiary\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "eftec/bladeone": "^4.19"
    },
    "require-dev": {
        "phpunit/phpunit": "^13",
        "phpstan/phpstan": "^2.2.7",
        "filp/whoops": "^2.18",
        "symplify/easy-coding-standard": "^13.2",
        "symplify/coding-standard": "^13.1"
    },
    "scripts": {
        "phpunit": "phpunit",
        "phpstan": "phpstan analyse --configuration=phpstan.dist.neon",
        "ecs": "ecs check",
        "ecs:fix": "ecs check --fix",
        "check": [
            "@phpunit",
            "@phpstan",
            "@ecs"
        ]
    },
    "config": {
        "platform": {
            "php": "8.5.1"
        }
    }
}
