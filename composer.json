{
    "name": "tamagoage/pet-diary",
    "autoload": {
        "psr-4": {
            "Tamagoage\\PetDiary\\": "src/"
        }
    },
    "require": {
        "eftec/bladeone": "^4.19"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.3",
        "phpstan/phpstan": "^2.1",
        "filp/whoops": "^2.18",
        "symplify/easy-coding-standard": "^13.0",
        "symplify/coding-standard": "^13.0"
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --configuration=phpstan.dist.neon",
        "ecs": "ecs check",
        "ecs:fix": "ecs check --fix",
        "check": [
            "@test",
            "@stan",
            "@ecs"
        ]
    },
    "config": {
        "platform": {
            "php": "8.5.1"
        }
    }
}
